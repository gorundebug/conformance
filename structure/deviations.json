    "boundary_reasons": {
      "transport": "Callback gRPC, Beast HTTP, librdkafka, DNS and EventEngine adapters use the common Coro workers; userver adapters remain canonical-only.",
      "execution": "Coro awaitable graph, coroutine mutex/task executor, initialization and blocking adapter replace task-runtime waiting. There is no cooperative_execution boundary.",
      "ownership": "strand_owned and worker_io_context define owner-context IO access and destruction for both epoll and uring.",
      "configuration_and_telemetry": "Runtime-specific configuration/status/logging/telemetry adapters retain the shared schema and observable contract. Retired runtime enum tokens are forbidden independently of shared-file differences.",
      "shared_operators": "Operator implementations await consumer/business calls; exact public differences are audited by signatures/deviations.json, runtime semantics by operator/transport suites."
    }
  },
