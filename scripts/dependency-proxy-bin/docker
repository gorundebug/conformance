#!/bin/sh
set -eu

conformance_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
dependencies_dir=${DEPENDENCIES_DIR:-$conformance_root/.dependencies}
wrapper=$dependencies_dir/cppexample/scripts/docker-dependency-proxy.generated.sh
if [ ! -x "$wrapper" ]; then
  echo "generated Docker dependency proxy wrapper is missing: $wrapper" >&2
  exit 2
fi
exec "$wrapper" "$@"
